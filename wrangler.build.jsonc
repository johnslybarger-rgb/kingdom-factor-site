{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kingdom-factor-site",
  "compatibility_date": "2026-05-08",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "PUBLIC_SITE_URL": "https://www.purpose-drivenconsulting.net",
    "SITE_URL": "https://www.purpose-drivenconsulting.net"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kingdom-factor-emdash",
      "database_id": "04144914-029c-4b82-9ccf-2ecdc3b0448d"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "kingdom-factor-media"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "4a0e5833c41d43f680f4c8bf0d16f381"
    }
  ]
}
