---
interface Props { eyebrow?: string; title: string; text?: string; align?: "center" | "left"; }
const { eyebrow, title, text, align = "left" } = Astro.props;
---
<div class:list={["section-header", align === "center" && "center"]}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2>{title}</h2>
  {text && <p>{text}</p>}
</div>
