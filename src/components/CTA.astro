---
interface Props { eyebrow?: string; title?: string; text?: string; primaryLabel?: string; primaryHref?: string; secondaryLabel?: string; secondaryHref?: string; }
const {
  eyebrow = "Next step",
  title = "Find the right room for the season you are leading through.",
  text = "Start with a simple fit conversation. We will help you discern whether peer advisory, private coaching, or a leadership-circle pathway is the best next step.",
  primaryLabel = "Request a fit conversation",
  primaryHref = "/apply/",
  secondaryLabel = "Explore peer advisory",
  secondaryHref = "/peer-advisory-groups/",
} = Astro.props;
---
<section class="cta-band">
  <div>
    <p class="eyebrow">{eyebrow}</p>
    <h2>{title}</h2>
    <p>{text}</p>
  </div>
  <div class="cta-actions">
    <a class="btn btn-light" href={primaryHref}>{primaryLabel}</a>
    <a class="btn btn-outline-light" href={secondaryHref}>{secondaryLabel}</a>
  </div>
</section>
