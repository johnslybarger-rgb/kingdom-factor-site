---
import { nav } from "../lib/site";
---
<footer class="site-footer">
  <div class="footer-grid refined-footer-grid">
    <div class="footer-intro">
      <img class="footer-logo" src="/images/brand/kf-logo.png" alt="Kingdom Factor" width="426" height="140" />
      <p>Peer advisory, executive coaching, and marketplace ministry for Christian business owners and leaders who want wisdom in the room.</p>
    </div>
    <div>
      <h2>Explore</h2>
      <ul>
        {nav.slice(0, 4).map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </div>
    <div>
      <h2>Connect</h2>
      <ul>
        <li><a href="/about/">About Kingdom Factor</a></li>
        <li><a href="/apply/">Request a fit conversation</a></li>
        <li><a href="/contact/">Contact</a></li>
        <li><a href="/books/">Books & resources</a></li>
      </ul>
    </div>
  </div>
  <div class="footer-bottom">
    <span>© {new Date().getFullYear()} Kingdom Factor.</span>
    <span><a href="/privacy/">Privacy</a> · <a href="/terms/">Terms</a></span>
  </div>
</footer>
