---
import { site } from "../lib/site";

interface Props {
  type?: "Organization" | "WebPage" | "Service" | "FAQPage" | "BlogPosting";
  title?: string;
  description?: string;
  path?: string;
  breadcrumbs?: { name: string; item: string }[];
  faqs?: { q: string; a: string }[];
  authorName?: string;
  authorPath?: string;
  datePublished?: string;
  dateModified?: string;
  image?: string;
}

const {
  type = "Organization",
  title = site.name,
  description = site.description,
  path = Astro.url.pathname,
  breadcrumbs = [],
  faqs = [],
  authorName,
  authorPath,
  datePublished,
  dateModified,
  image,
} = Astro.props;

const url = new URL(path, site.url).toString();
const graph: Record<string, unknown>[] = [
  {
    "@type": "Organization",
    "@id": `${site.url}/#organization`,
    name: site.organization.name,
    legalName: site.organization.legalName,
    alternateName: site.name,
    url: site.url,
    description: site.description,
    founder: {
      "@type": "Person",
      name: site.organization.founder,
    },
    brand: {
      "@type": "Brand",
      name: site.organization.brand,
      description: `${site.name} is the faith-integrated leadership ministry of ${site.organization.legalName}.`,
    },
  },
  {
    "@type": "WebSite",
    "@id": `${site.url}/#website`,
    name: site.name,
    url: site.url,
    description: site.description,
    publisher: { "@id": `${site.url}/#organization` },
  },
];

if (type !== "Organization" && type !== "BlogPosting") {
  graph.push({
    "@type": type === "FAQPage" ? "FAQPage" : "WebPage",
    "@id": `${url}#webpage`,
    url,
    name: title,
    description,
    isPartOf: { "@id": `${site.url}/#website` },
    about: { "@id": `${site.url}/#organization` },
    ...(faqs.length
      ? {
          mainEntity: faqs.map((faq) => ({
            "@type": "Question",
            name: faq.q,
            acceptedAnswer: { "@type": "Answer", text: faq.a },
          })),
        }
      : {}),
  });
}

if (type === "BlogPosting") {
  graph.push({
    "@type": "BlogPosting",
    "@id": `${url}#article`,
    url,
    headline: title,
    description,
    mainEntityOfPage: { "@id": `${url}#webpage` },
    isPartOf: { "@id": `${site.url}/#website` },
    publisher: { "@id": `${site.url}/#organization` },
    ...(authorName
      ? {
          author: {
            "@type": "Person",
            name: authorName,
            ...(authorPath ? { url: new URL(authorPath, site.url).toString() } : {}),
          },
        }
      : {}),
    ...(datePublished ? { datePublished } : {}),
    ...(dateModified ? { dateModified } : {}),
    ...(image ? { image: new URL(image, site.url).toString() } : {}),
  });

  graph.push({
    "@type": "WebPage",
    "@id": `${url}#webpage`,
    url,
    name: title,
    description,
    isPartOf: { "@id": `${site.url}/#website` },
    about: { "@id": `${site.url}/#organization` },
    mainEntity: { "@id": `${url}#article` },
  });
}

if (type === "Service") {
  graph.push({
    "@type": "Service",
    name: title,
    description,
    provider: { "@id": `${site.url}/#organization` },
    areaServed: "United States",
    audience: "Christian business owners and leaders",
  });
}

if (breadcrumbs.length) {
  graph.push({
    "@type": "BreadcrumbList",
    itemListElement: breadcrumbs.map((crumb, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: crumb.name,
      item: new URL(crumb.item, site.url).toString(),
    })),
  });
}

const schema = { "@context": "https://schema.org", "@graph": graph };
---
<script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
