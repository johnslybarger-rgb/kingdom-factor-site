---
import { nav } from "../lib/site";
---
<header class="site-header">
  <a class="brand" href="/" aria-label="Kingdom Factor home">
    <img class="brand-logo" src="/images/brand/kf-logo.png" alt="Kingdom Factor" width="426" height="140" />
    <span class="brand-text">
      <strong>Kingdom Factor</strong>
      <small>Business • Faith • Counsel</small>
    </span>
  </a>

  <a class="header-cta" href="/apply/">Fit Conversation</a>

  <details class="mobile-nav global-menu">
    <summary aria-label="Open menu">
      <span class="menu-glyph" aria-hidden="true">
        <svg viewBox="0 0 24 24" role="presentation">
          <path d="M6 8.5h12" />
          <path d="M6 15.5h12" />
        </svg>
      </span>
      <strong>Menu</strong>
    </summary>
    <div class="mobile-menu-panel">
      <nav aria-label="Mobile navigation">
        {nav.map((item) => <a href={item.href}>{item.label}</a>)}
        <a href="/contact/">Contact</a>
      </nav>
      <a class="btn btn-primary" href="/apply/">Request a fit conversation</a>
    </div>
  </details>
</header>
