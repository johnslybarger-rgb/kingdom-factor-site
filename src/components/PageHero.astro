---
interface Props { eyebrow: string; title: string; subheading?: string; text: string; primary?: { label: string; href: string }; secondary?: { label: string; href: string }; image?: string; imageMobile?: string; }
const { eyebrow, title, subheading, text, primary, secondary, image = "/images/generated/advisory-room-1440.webp", imageMobile = "/images/generated/advisory-room-mobile.webp" } = Astro.props;
---
<section class="page-hero">
  <div class="hero-content">
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    {subheading && <p class="hero-subheading">{subheading}</p>}
    <p>{text}</p>
    <div class="actions">
      {primary && <a class="btn btn-primary" href={primary.href}>{primary.label}</a>}
      {secondary && <a class="btn btn-secondary" href={secondary.href}>{secondary.label}</a>}
    </div>
  </div>
  <div class="route-hero-visual photo-hero-card" aria-label="Kingdom Factor advisory atmosphere">
    <picture>
      <source media="(max-width: 640px)" srcset={imageMobile} />
      <img src={image} alt="" loading="lazy" />
    </picture>
    <div class="photo-card-caption">
      <img src="/images/brand/kf-logo.png" alt="Kingdom Factor" loading="lazy" />
      <p>Wisdom in the room</p>
    </div>
  </div>
</section>
