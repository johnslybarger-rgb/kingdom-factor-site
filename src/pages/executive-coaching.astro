---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import CTA from "../components/CTA.astro";
import Schema from "../components/Schema.astro";
import { pages } from "../lib/pages";

const page = pages["executive-coaching"];
const schemaType = page.faqs?.length ? "FAQPage" : "Service";

const coreOutcomes = [
  { name: "Kingdom Culture Blueprint", body: "A one-page document defining mission, values, and behaviors that connect biblical convictions to business decisions." },
  { name: "Culture Health Snapshot", body: "Three to five key indicators (turnover risk, engagement, relational trust, spiritual environment) with two or three prioritized focus areas." },
  { name: "Weekly leadership rhythm", body: "An executive meeting agenda, questions, and cadence that integrates Scripture, prayer, people metrics, and results." },
  { name: "Two redesigned people systems", body: "For example: hiring, onboarding, 1:1s, feedback, or performance reviews — rebuilt to reflect biblical principles and business excellence." },
  { name: "Personal decision framework", body: "A repeatable framework for hard calls — hiring and firing, restructuring, conflict — rooted in Scripture and wise stewardship." },
];

const phases = [
  {
    label: "Phase 1 · Clarify",
    weeks: "Weeks 1–4",
    sessions: [
      {
        title: "Session 1 — Story, Calling, and Current Reality",
        bullets: [
          "Soul and leadership check-in, brief spiritual discernment around calling and season.",
          "Map the current business landscape: growth, key pressures, culture pain points, and people issues.",
          "Define success metrics for the intensive across three lenses: spiritual (peace, clarity), people (turnover, conflict), and business (key KPIs).",
        ],
        between: "Short reflective exercises on faith, calling, and leadership; simple pulse survey or interviews with three to five key staff for culture truth-telling.",
      },
      {
        title: "Session 2 — Kingdom Culture Blueprint",
        bullets: [
          "Articulate mission, vision, and four to six core values with explicit biblical anchors and behaviors.",
          "Identify where you're aligned vs. where you're drifting in current practices (comp, accountability, pace, care).",
        ],
        deliverable: "Draft one-page Kingdom Culture Blueprint.",
      },
    ],
  },
  {
    label: "Phase 2 · Diagnose",
    weeks: "Weeks 5–8",
    sessions: [
      {
        title: "Session 3 — Culture Health Snapshot",
        bullets: [
          "Review staff input and observations, identify patterns of health and harm (silos, fear, overwork, cynicism).",
          "Create a simple culture dashboard with three to five indicators (red / yellow / green), each with practical definitions and examples.",
        ],
      },
      {
        title: "Session 4 — Leadership Rhythm Design",
        bullets: [
          "Design a weekly executive meeting rhythm that integrates Scripture, prayer, people, and performance (agenda, roles, time boxes).",
          "Add a monthly Shepherding & Strategy block for deeper people issues, development, and spiritual formation.",
        ],
        deliverable: "Culture dashboard v1, weekly rhythm template, first four weeks agenda map.",
      },
    ],
  },
  {
    label: "Phase 3 · Implement",
    weeks: "Weeks 9–12",
    sessions: [
      {
        title: "Session 5 — People Systems Upgrade",
        bullets: [
          "Choose two people systems to rework — for example, 1:1s, feedback, hiring, or conflict resolution.",
          "Redesign them to align with the Kingdom Culture Blueprint and biblical principles of justice, truth-telling, grace, and stewardship.",
        ],
      },
      {
        title: "Session 6 — Hard Decisions and Sustainability",
        bullets: [
          "Apply the decision framework to one or two live, high-stakes issues the owner or senior leader is currently facing.",
          "Transition into an ongoing peer advisory group.",
        ],
        deliverable: "Two reworked systems (templates and scripts), decision framework, six- to twelve-month plan.",
      },
    ],
  },
];
---
<Base title="Kingdom Culture Intensive — Executive Coaching with Dr. John Lybarger" description="A 90-day executive coaching intensive for Christian business owners and senior leaders: confidential 1:1 coaching plus peer advisory to align faith, culture, and performance." canonical="/executive-coaching/">
  <Schema
    type={schemaType}
    title={page.title}
    description={page.description}
    path={`/${page.slug}/`}
    breadcrumbs={[{ name: "Home", item: "/" }, { name: page.title, item: `/${page.slug}/` }]}
    faqs={page.faqs}
  />

  <PageHero
    eyebrow={page.eyebrow}
    title={page.heading}
    subheading={page.subheading}
    text={page.description}
    primary={page.primaryCta}
    secondary={page.secondaryCta}
    image={page.heroImage}
    imageMobile={page.heroImageMobile}
  />

  <section class="kci-narrative">
    <div class="kci-narrative-inner">
      <p class="eyebrow">Kingdom Culture Intensive</p>
      <h2>90 days to align faith, culture, and performance.</h2>
      <p>Christian business owners and senior leaders often tell me they feel the weight of constant decisions, the pressure to deliver results, and the quiet fear that their culture isn't as healthy or as Christ-centered as they hoped. They're tired of leading alone, navigating staff issues in the dark, and wondering if their current pace, systems, and habits are quietly burning out their best people.</p>
      <p>After this coaching, they describe having a clearer, Kingdom-shaped vision for the business, a more honest read on their culture, and simple rhythms that help them lead with peace while actually improving performance and team health.</p>
    </div>
  </section>

  <section class="kci-streams">
    <div class="kci-streams-inner">
      <p class="eyebrow">Two streams of support</p>
      <h2>You don't have to lead in isolation.</h2>
      <p>You get two powerful streams of support: confidential 1:1 coaching where we work deeply on your soul, your leadership, and your specific decisions, and a high-caliber peer advisory group of Christian business leaders who bring seasoned, prayerful perspective to your real-time challenges.</p>
      <p>Together, we clarify what wholehearted faithfulness looks like in your business, surface the unspoken truth about your culture, and install a simple, sustainable way of leading that honors Christ and delivers results. You'll walk away with a clear Kingdom vision for your company, a practical playbook for your people and systems, and a circle of peers who continue to walk with you as you navigate high-stakes decisions at the top.</p>
    </div>
  </section>

  <section class="content-section offer-detail-section">
    <div class="section-header compact">
      <p class="eyebrow">The leadership weight</p>
      <h2>The challenges that stack on top of each other.</h2>
      <p>For Christian business owners and senior leaders, several pressures rarely show up one at a time.</p>
    </div>
    <div class="content-grid offer-detail-grid">
      <article class="content-card offer-detail-card">
        <span class="card-number">01</span>
        <h3>Loneliness in leadership</h3>
        <p>Limited safe, peer-level spaces to process decisions, doubts, and spiritual questions with people who actually understand the weight you carry.</p>
      </article>
      <article class="content-card offer-detail-card">
        <span class="card-number">02</span>
        <h3>Targets vs. culture</h3>
        <p>Pressure to hit financial numbers while also building a values-driven, healthy culture. Disengagement and turnover are massively costly.</p>
      </article>
      <article class="content-card offer-detail-card">
        <span class="card-number">03</span>
        <h3>Faith meets modern systems</h3>
        <p>Integrating biblical conviction with OKRs, hybrid work, and modern business systems in a way that feels coherent and not bolted on.</p>
      </article>
      <article class="content-card offer-detail-card">
        <span class="card-number">04</span>
        <h3>Team well-being</h3>
        <p>Concern for the mental, emotional, and spiritual health of your team, especially as burnout and isolation continue to rise.</p>
      </article>
    </div>
  </section>

  <section class="content-section offer-detail-section">
    <div class="section-header compact">
      <p class="eyebrow">Ideal owner / senior leader profile</p>
      <h2>Who this intensive is built for.</h2>
    </div>
    <div class="content-grid offer-detail-grid">
      <article class="content-card offer-detail-card">
        <span class="card-number">A</span>
        <h3>Already profitable, feeling stretched</h3>
        <p>Christian owner or senior leader running a profitable business, but feeling stuck, stretched, or uneasy about culture and health.</p>
      </article>
      <article class="content-card offer-detail-card">
        <span class="card-number">B</span>
        <h3>Faith-and-business tension</h3>
        <p>Values Scripture, prayer, and integrity, but feels tension between faith and the hard business realities of layoffs, growth targets, and performance management.</p>
      </article>
      <article class="content-card offer-detail-card">
        <span class="card-number">C</span>
        <h3>Isolated at the top</h3>
        <p>Feels isolated in big decisions, carries decision fatigue, and worries about burnout or disengagement on the team.</p>
      </article>
    </div>
  </section>

  <section class="kci-promise">
    <blockquote>
      <p>We will clarify your Kingdom-shaped vision, assess the real health of your culture, and install a simple, faith-integrated leadership rhythm so you can lead with peace, strengthen your people, and improve performance without compromising your convictions.</p>
      <footer>— The Kingdom Culture Intensive promise</footer>
    </blockquote>
  </section>

  <section class="content-section offer-detail-section">
    <div class="section-header compact">
      <p class="eyebrow">Core outcomes</p>
      <h2>By the end of 90 days, you will have:</h2>
    </div>
    <div class="content-grid offer-detail-grid kci-outcomes-grid">
      {coreOutcomes.map((outcome, i) => (
        <article class="content-card offer-detail-card">
          <span class="card-number">{String(i + 1).padStart(2, "0")}</span>
          <h3>{outcome.name}</h3>
          <p>{outcome.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="kci-structure">
    <div class="kci-structure-inner">
      <p class="eyebrow">Structure and flow</p>
      <h2>How the intensive is shaped.</h2>
      <p>We meet in a peer advisory group monthly for four hours and bi-weekly for deep 1:1 work, and I provide light-touch support between sessions.</p>
      <dl class="kci-structure-meta">
        <div><dt>Duration</dt><dd>90 days</dd></div>
        <div><dt>Sessions</dt><dd>Six 60-minute sessions, every ~2 weeks</dd></div>
        <div><dt>Support</dt><dd>Email and voice-note support, plus one short touch-base call between sessions as needed</dd></div>
      </dl>
    </div>
  </section>

  <section class="kci-phases">
    <div class="section-header compact">
      <p class="eyebrow">The three phases</p>
      <h2>Clarify, diagnose, implement.</h2>
      <p>Each phase builds on the last, and each session leaves you with concrete deliverables.</p>
    </div>
    <div class="kci-phase-list">
      {phases.map((phase, pIdx) => (
        <article class="kci-phase">
          <header class="kci-phase-head">
            <span class="kci-phase-num">0{pIdx + 1}</span>
            <div>
              <h3>{phase.label}</h3>
              <p>{phase.weeks}</p>
            </div>
          </header>
          <ol class="kci-session-list">
            {phase.sessions.map((session) => (
              <li class="kci-session">
                <h4>{session.title}</h4>
                <ul class="check-list">
                  {session.bullets.map((b) => <li>{b}</li>)}
                </ul>
                {session.between && (
                  <p class="kci-between"><strong>Between-session work:</strong> {session.between}</p>
                )}
                {session.deliverable && (
                  <p class="kci-deliverable"><strong>Deliverable:</strong> {session.deliverable}</p>
                )}
              </li>
            ))}
          </ol>
        </article>
      ))}
    </div>
  </section>

  <section class="kci-included">
    <div class="kci-included-inner">
      <p class="eyebrow">What's included</p>
      <h2>A bespoke, confidential 90-day intensive.</h2>
      <ul class="kci-included-list">
        <li>A bespoke, confidential 90-day intensive for Christian owners and senior leaders who are serious about aligning culture and leadership with the Kingdom while still competing and winning in the marketplace.</li>
        <li>Three 4-hour peer advisory group meetings and six 60-minute 1:1 sessions, plus interim support.</li>
        <li>Culture assessment tools, a customized Kingdom Culture Blueprint, Culture Health Snapshot, Leadership Rhythm Design, redesigned People Systems Upgrade, and Decision Framework.</li>
        <li>Ongoing participation in a monthly 4-hour peer advisory group and one 1:1 coaching meeting per month after the intensive.</li>
      </ul>
    </div>
  </section>

  <section class="kci-pricing">
    <div class="kci-pricing-inner">
      <p class="eyebrow">Investment</p>
      <h2>Two coaches, two price points.</h2>
      <div class="kci-pricing-grid">
        <article class="kci-price-card">
          <p class="kci-price-coach">Dr. John S. Lybarger</p>
          <p class="kci-price-amount">$6,000</p>
          <p class="kci-price-note">Full 90-day intensive, all tools and templates, access to a peer advisory group and monthly coaching during the intensive.</p>
          <a class="btn btn-primary" href="/apply/">Request a fit conversation</a>
        </article>
        <article class="kci-price-card">
          <p class="kci-price-coach">James C. "Jim" Lybarger</p>
          <p class="kci-price-amount">$3,000</p>
          <p class="kci-price-note">Full 90-day intensive, all tools and templates, access to a peer advisory group and monthly coaching during the intensive.</p>
          <a class="btn btn-primary" href="/apply/">Request a fit conversation</a>
        </article>
      </div>
    </div>
  </section>

  {page.faqs && (
    <section class="faq-section">
      <div class="section-header center">
        <p class="eyebrow">Common questions</p>
        <h2>What leaders ask before stepping in.</h2>
      </div>
      <div class="faq-list">
        {page.faqs.map((faq) => (
          <details>
            <summary>{faq.q}</summary>
            <p>{faq.a}</p>
          </details>
        ))}
      </div>
    </section>
  )}

  <CTA />
</Base>

<style>
  /* --------- Kingdom Culture Intensive long-form sections ---------- */
  .kci-narrative,
  .kci-streams,
  .kci-structure,
  .kci-included,
  .kci-pricing {
    max-width: var(--max);
    margin: 0 auto;
    padding: clamp(2.75rem, 5vw, 4.5rem) clamp(1rem, 4vw, 2rem);
  }
  .kci-narrative-inner,
  .kci-streams-inner,
  .kci-structure-inner,
  .kci-included-inner,
  .kci-pricing-inner {
    max-width: 880px;
    margin: 0 auto;
  }
  .kci-narrative h2,
  .kci-streams h2,
  .kci-structure h2,
  .kci-included h2,
  .kci-pricing h2 {
    font-size: clamp(2rem, 3.6vw, 3.1rem);
    text-wrap: balance;
    margin-bottom: 1.1rem;
  }
  .kci-narrative p,
  .kci-streams p,
  .kci-structure p,
  .kci-included li {
    font-size: clamp(1.04rem, 1.2vw, 1.16rem);
    line-height: 1.72;
    color: #4d423b;
    margin-bottom: 1rem;
  }

  .kci-streams {
    background: rgba(255, 250, 242, 0.62);
    max-width: none;
    padding-left: clamp(1rem, 4vw, 2rem);
    padding-right: clamp(1rem, 4vw, 2rem);
  }

  .kci-promise {
    max-width: var(--max);
    margin: 0 auto;
    padding: clamp(2.25rem, 4vw, 3.5rem) clamp(1rem, 4vw, 2rem);
  }
  .kci-promise blockquote {
    max-width: 880px;
    margin: 0 auto;
    padding: clamp(1.5rem, 3vw, 2.2rem) clamp(1.5rem, 4vw, 2.6rem);
    background: linear-gradient(135deg, rgba(100, 31, 36, 0.06), rgba(213, 178, 111, 0.12));
    border-left: 4px solid var(--burgundy, #641f24);
    border-radius: 18px;
  }
  .kci-promise blockquote p {
    font-size: clamp(1.25rem, 1.8vw, 1.5rem);
    line-height: 1.55;
    color: var(--burgundy-dark, #4a0f15);
    font-style: italic;
    text-wrap: balance;
    margin-bottom: 0.85rem;
  }
  .kci-promise blockquote footer {
    font-size: 0.92rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(100, 31, 36, 0.72);
    font-style: normal;
  }

  .kci-structure-meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    gap: clamp(1rem, 2vw, 1.5rem);
    margin-top: 1.6rem;
  }
  .kci-structure-meta > div {
    padding: 1rem 1.2rem;
    background: rgba(255, 250, 242, 0.78);
    border: 1px solid rgba(168, 148, 131, 0.32);
    border-radius: 14px;
  }
  .kci-structure-meta dt {
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--burgundy, #641f24);
    margin-bottom: 0.35rem;
    font-weight: 700;
  }
  .kci-structure-meta dd {
    font-size: 1rem;
    line-height: 1.5;
    color: #4d423b;
    margin: 0;
  }

  .kci-phases {
    max-width: var(--max);
    margin: 0 auto;
    padding: clamp(3rem, 6vw, 5rem) clamp(1rem, 4vw, 2rem);
  }
  .kci-phase-list {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.4rem);
    margin-top: clamp(1.8rem, 3vw, 2.6rem);
  }
  .kci-phase {
    background: rgba(255, 250, 242, 0.55);
    border: 1px solid rgba(168, 148, 131, 0.32);
    border-radius: 24px;
    padding: clamp(1.5rem, 3vw, 2.4rem);
  }
  .kci-phase-head {
    display: flex;
    gap: 1.2rem;
    align-items: flex-start;
    margin-bottom: 1.5rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid rgba(168, 148, 131, 0.32);
  }
  .kci-phase-num {
    font-size: clamp(1.6rem, 2.6vw, 2.2rem);
    font-weight: 800;
    color: var(--burgundy, #641f24);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .kci-phase-head h3 {
    font-size: clamp(1.4rem, 2vw, 1.85rem);
    margin: 0;
    color: var(--burgundy-dark, #4a0f15);
  }
  .kci-phase-head p {
    margin: 0.2rem 0 0;
    color: #6b5d54;
    font-size: 0.95rem;
    letter-spacing: 0.04em;
  }
  .kci-session-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1.4rem;
  }
  .kci-session h4 {
    font-size: clamp(1.1rem, 1.4vw, 1.28rem);
    color: var(--burgundy-dark, #4a0f15);
    margin: 0 0 0.7rem;
  }
  .kci-session .check-list li {
    color: #4d423b;
  }
  .kci-between,
  .kci-deliverable {
    margin-top: 0.7rem;
    font-size: 0.96rem;
    color: #51463f;
    line-height: 1.6;
  }
  .kci-between strong,
  .kci-deliverable strong {
    color: var(--burgundy, #641f24);
    font-weight: 700;
  }

  .kci-included-list {
    list-style: none;
    padding: 0;
    margin: 1.2rem 0 0;
    display: grid;
    gap: 0.9rem;
  }
  .kci-included-list li {
    position: relative;
    padding-left: 1.5rem;
  }
  .kci-included-list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.7em;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--burgundy, #641f24);
  }

  .kci-pricing {
    background: rgba(255, 250, 242, 0.62);
    max-width: none;
    padding-left: clamp(1rem, 4vw, 2rem);
    padding-right: clamp(1rem, 4vw, 2rem);
  }
  .kci-pricing-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: clamp(1rem, 2vw, 1.6rem);
    margin-top: 1.5rem;
  }
  .kci-price-card {
    background: var(--warm-white, #fff7eb);
    border: 1px solid rgba(168, 148, 131, 0.32);
    border-radius: 22px;
    padding: clamp(1.5rem, 2.6vw, 2rem);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .kci-price-coach {
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--burgundy, #641f24);
    font-weight: 700;
    margin: 0;
  }
  .kci-price-amount {
    font-family: var(--display, "Cormorant Garamond", "Source Serif Pro", Georgia, serif);
    font-size: clamp(2.6rem, 4vw, 3.6rem);
    line-height: 1;
    color: var(--burgundy-dark, #4a0f15);
    margin: 0;
    letter-spacing: -0.02em;
  }
  .kci-price-note {
    font-size: 0.96rem;
    line-height: 1.55;
    color: #4d423b;
    margin: 0 0 0.5rem;
  }
  .kci-price-card .btn {
    align-self: flex-start;
    margin-top: auto;
  }

  .kci-outcomes-grid {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)) !important;
  }

  @media (max-width: 760px) {
    .kci-phase-head { flex-direction: column; gap: 0.4rem; }
    .kci-phase-num { font-size: 1.4rem; }
  }
</style>
