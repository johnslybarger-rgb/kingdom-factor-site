---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import Schema from "../components/Schema.astro";
---
<Base title="Contact" description="Contact Kingdom Factor. Public contact details and routing are pending approval." canonical="/contact/">
  <Schema type="WebPage" title="Contact Kingdom Factor" description="Contact Kingdom Factor. Public contact details and routing are pending approval." path="/contact/" breadcrumbs={[{ name: "Home", item: "/" }, { name: "Contact", item: "/contact/" }]} />
  <PageHero eyebrow="Contact" title="Reach the Kingdom Factor team." text="Public contact details, inbox routing, and form destination are pending approval. This draft keeps the page ready without creating external commitments." primary={{ label: "Fit conversation", href: "/apply/" }} secondary={{ label: "Back to home", href: "/" }} />
  <section class="content-section">
    <div class="form-placeholder">
      <p class="eyebrow">Routing pending</p>
      <h2>Contact destination to confirm</h2>
      <p>Before launch, confirm the public email, phone, contact form endpoint, CRM workflow, calendar link, John/Jim routing rules, and response expectations.</p>
    </div>
  </section>
</Base>
