---
import Base from "../layouts/Base.astro";
import CTA from "../components/CTA.astro";
import Schema from "../components/Schema.astro";
import SectionHeader from "../components/SectionHeader.astro";
import { offers, pillars, people, bookHighlights, seoOpportunities } from "../lib/site";
---
<Base title="Kingdom Factor" description="A trusted advisory circle for Christian business owners who want to lead with wisdom, faith, and accountability.">
  <Schema />
  <section class="home-hero polished-hero">
    <div class="hero-copy">
      <p class="eyebrow">Christian business leadership</p>
      <h1>A trusted room for Christian owners carrying real decisions.</h1>
      <p>Kingdom Factor helps faith-driven owners and leaders integrate biblical conviction with practical business counsel through peer advisory, executive coaching, marketplace ministry, and leadership resources.</p>
      <div class="actions">
        <a class="btn btn-primary" href="/apply/">Schedule an introductory conversation</a>
        <a class="btn btn-secondary" href="/leadership-circle/">Explore the Leadership Circle</a>
      </div>
      <div class="trust-strip" aria-label="Kingdom Factor positioning">
        <span>Peer advisory</span>
        <span>Executive coaching</span>
        <span>Marketplace ministry</span>
      </div>
    </div>
    <div class="roundtable-visual premium-visual brand-showcase generated-hero" aria-label="Premium advisory room visual">
      <picture>
        <source media="(max-width: 640px)" srcset="/images/generated/advisory-room-mobile.webp" />
        <img class="brand-bg" src="/images/generated/advisory-room-1440.webp" alt="" loading="eager" />
      </picture>
      <div class="brand-glass-card hero-logo-card">
        <img src="/images/brand/kf-logo.png" alt="Kingdom Factor" />
        <p>Faith-shaped counsel for decisions that matter.</p>
      </div>
      <div class="note note-a">Counsel</div>
      <div class="note note-b">Wisdom</div>
      <div class="note note-c">Faith</div>
    </div>
  </section>

  <section class="split-section elevated-split">
    <div>
      <p class="eyebrow">The problem</p>
      <h2>Leadership gets heavy when there is no trusted, faith-integrated room.</h2>
    </div>
    <p>Owners carry pressure, blind spots, decision fatigue, lonely choices, and the tension of honoring both stewardship and growth. Kingdom Factor gives that weight a place to be processed with trusted counsel, biblical accountability, and practical business wisdom.</p>
  </section>

  <section class="pillar-section">
    <SectionHeader eyebrow="The Kingdom Factor model" title="Three ways leaders get the room they need." text="A focused ecosystem for owners and leaders who want practical business counsel without separating strategy from faith." align="center" />
    <div class="three-grid">
      {pillars.map((pillar) => (
        <article class="pillar-card premium-card">
          <h3>{pillar.title}</h3>
          <p>{pillar.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section id="paths" class="lane-section">
    <SectionHeader eyebrow="Choose your path" title="One Kingdom Factor platform. Two clear leadership lanes." text="Established executives and emerging owners can each find a pathway shaped around their leadership season." align="center" />
    <div class="lane-grid">
      {people.map((person) => (
        <article class={`lane-card leader-lane ${person.lane === "John lane" ? "executive" : "community"}`}>
          <img class="leader-portrait" src={person.image} alt={person.name} loading="lazy" />
          <p class="eyebrow">{person.lane}</p>
          <h3>{person.name}</h3>
          <p><strong>{person.role}</strong></p>
          <p>{person.summary}</p>
          <a class="text-link" href={person.href}>Explore this pathway →</a>
        </article>
      ))}
    </div>
  </section>

  <section class="offer-section">
    <SectionHeader eyebrow="Offer ecosystem" title="A connected path from curiosity to conversation." text="Awareness should move into a resource, webinar, preview conversation, fit call, and eventually application when routing is approved." align="center" />
    <div class="offer-grid">
      {offers.map((offer) => (
        <article class="offer-card premium-card">
          <p>{offer.audience}</p>
          <h3>{offer.title}</h3>
          <p>{offer.summary}</p>
          <a href={offer.href}>View pathway →</a>
        </article>
      ))}
    </div>
  </section>

  <section class="authority-section">
    <div class="authority-copy">
      <p class="eyebrow">Author authority</p>
      <h2>Books, webinars, and leadership IP become the trust layer.</h2>
      <p>John and Jim’s resource library gives Kingdom Factor a deeper authority base than a typical coaching website, with topics spanning marketplace ministry, accountability, leadership development, story, and practical faith integration.</p>
      <a class="btn btn-secondary" href="/books/">View books and resources</a>
    </div>
    <div class="image-feature-card motion-card">
      <picture>
        <source media="(max-width: 640px)" srcset="/images/generated/leadership-table-mobile.webp" />
        <img src="/images/generated/leadership-table-1440.webp" alt="Leadership table with warm executive counsel materials" loading="lazy" />
      </picture>
      <div class="book-cloud overlay-cloud">
        {bookHighlights.slice(0, 6).map((book) => <span>{book}</span>)}
      </div>
    </div>
  </section>

  <section class="seo-section">
    <SectionHeader eyebrow="Leadership topics" title="Built around the questions Christian owners are already carrying." text="The resource path can grow into practical guides for faith-and-business leadership, peer counsel, accountability, and stewardship." align="center" />
    <div class="keyword-grid">
      {seoOpportunities.map((keyword) => <span>{keyword}</span>)}
    </div>
  </section>

  <section class="source-section">
    <div class="source-panel">
      <p class="eyebrow">Kingdom Factor Collective</p>
      <h2>Existing public content can support a story-driven authority strategy.</h2>
      <p>The Collective path can preserve and organize stories, interviews, and leadership lessons into a stronger topical hub for Christian business owners.</p>
      <a class="btn btn-secondary" href="/collective/">Explore the Collective path</a>
    </div>
    <div class="source-list visual-source-list">
      <picture class="source-photo">
        <source media="(max-width: 640px)" srcset="/images/generated/collective-studio-mobile.webp" />
        <img src="/images/generated/collective-studio-1440.webp" alt="Interview studio for Kingdom Factor stories" loading="lazy" />
      </picture>
      <span>Faith in business stories</span>
      <span>Leadership Circle webinar</span>
      <span>Marketplace Ministry teaching</span>
      <span>Executive Coaching Intensive</span>
    </div>
  </section>

  <CTA />
</Base>
