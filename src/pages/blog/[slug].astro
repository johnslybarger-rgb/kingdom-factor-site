---
import Base from "../../layouts/Base.astro";
import Schema from "../../components/Schema.astro";
import CTA from "../../components/CTA.astro";
import { getEmDashEntry } from "emdash";
import { PortableText, Image as EmDashImage } from "emdash/ui";

const { slug } = Astro.params;

// Load the post defensively. Missing entry (or unprovisioned CMS DB) → back to /blog.
let post: any = null;
let author: any = null;
try {
  const res = await getEmDashEntry("posts", slug ?? "");
  post = res?.entry ?? null;
  if (post?.data?.author) {
    const authorRes = await getEmDashEntry("authors", post.data.author);
    author = authorRes?.entry ?? null;
  }
} catch {
  post = null;
}

if (!post) {
  return Astro.redirect("/blog/");
}

const title = post.data?.title ?? "Kingdom Factor";
const metaTitle = post.data?.meta_title ?? `${title} | Kingdom Factor`;
const metaDescription = post.data?.meta_description ?? post.data?.excerpt ?? "";
const body = Array.isArray(post.data?.content) ? post.data.content : null;
const authorSlug = post.data?.author;
const fmtDate = (v: unknown) => {
  if (!v) return "";
  const d = new Date(v as string);
  return Number.isNaN(d.getTime())
    ? ""
    : d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
};
const publishedDate = fmtDate(post.data?.published_at);
---
<Base title={metaTitle} description={metaDescription} canonical={`/blog/${slug}/`}>
  <Schema type="WebPage" title={metaTitle} description={metaDescription} path={`/blog/${slug}/`} breadcrumbs={[{ name: "Home", item: "/" }, { name: "Blog", item: "/blog/" }, { name: title, item: `/blog/${slug}/` }]} />

  <article class="post">
    <header class="post-header">
      <p class="post-breadcrumb"><a href="/blog/">← Back to all articles</a></p>
      {post.data?.category && <p class="eyebrow post-category">{post.data.category}</p>}
      <h1>{title}</h1>
      {author && (
        <div class="post-byline">
          {author.data?.photo && (
            <span class="post-byline-photo"><EmDashImage image={author.data.photo} /></span>
          )}
          <span class="post-byline-text">
            <span class="post-byline-name">
              By <a href={`/blog/author/${authorSlug}/`}>{author.data?.name}</a>
            </span>
            {author.data?.bio && <span class="post-byline-bio">{author.data.bio}</span>}
            {publishedDate && <span class="post-byline-date">{publishedDate}</span>}
          </span>
        </div>
      )}
    </header>

    {post.data?.featured_image && (
      <div class="post-hero-image"><EmDashImage image={post.data.featured_image} /></div>
    )}

    <div class="post-body">
      {body ? <PortableText value={body} /> : <p>{post.data?.excerpt}</p>}
    </div>

    {author && (
      <aside class="post-author-card">
        {author.data?.photo && (
          <span class="post-author-photo"><EmDashImage image={author.data.photo} /></span>
        )}
        <div>
          <p class="eyebrow">About the author</p>
          <h2>
            <a href={`/blog/author/${authorSlug}/`}>{author.data?.name}</a>
          </h2>
          {author.data?.role && <p class="post-author-role">{author.data.role}</p>}
          {author.data?.full_bio && <p>{author.data.full_bio}</p>}
          {author.data?.linkedin && (
            <a class="post-author-link" href={author.data.linkedin} target="_blank" rel="noopener">Connect on LinkedIn →</a>
          )}
        </div>
      </aside>
    )}
  </article>

  <CTA />
</Base>

<style>
  .post {
    max-width: 760px;
    margin: 0 auto;
    padding: clamp(2.5rem, 6vw, 5rem) clamp(1rem, 4vw, 2rem) clamp(2rem, 4vw, 3rem);
  }
  .post-breadcrumb { margin: 0 0 1.25rem; }
  .post-breadcrumb a { color: var(--burgundy, #641f24); font-weight: 600; text-decoration: none; font-size: 0.92rem; }
  .post-category { margin-bottom: 0.5rem; }
  .post-header h1 {
    font-size: clamp(2.2rem, 4.6vw, 3.6rem);
    line-height: 1.08;
    margin: 0 0 1.4rem;
    text-wrap: balance;
  }
  .post-byline { display: flex; align-items: center; gap: 0.9rem; margin-top: 1.25rem; }
  .post-byline-photo :global(img),
  .post-author-photo :global(img) {
    width: 100%; height: 100%; object-fit: cover; border-radius: 50%;
  }
  .post-byline-photo { width: 52px; height: 52px; border-radius: 50%; overflow: hidden; flex: 0 0 auto; border: 1px solid rgba(181, 138, 68, 0.4); }
  .post-byline-text { display: flex; flex-direction: column; gap: 0.1rem; }
  .post-byline-name { font-weight: 600; color: var(--ink, #2a2320); }
  .post-byline-name a { color: var(--burgundy, #641f24); text-decoration: none; }
  .post-byline-name a:hover { text-decoration: underline; }
  .post-byline-bio { font-size: 0.9rem; color: rgba(81, 70, 63, 0.85); max-width: 60ch; }
  .post-byline-date { font-size: 0.85rem; color: rgba(81, 70, 63, 0.7); }
  .post-hero-image { margin: clamp(1.5rem, 3vw, 2.5rem) 0; border-radius: 22px; overflow: hidden; }
  .post-hero-image :global(img) { width: 100%; height: auto; display: block; }
  .post-body { font-size: clamp(1.05rem, 1.35vw, 1.18rem); line-height: 1.75; color: #3f3833; }
  .post-body :global(h2) { font-size: clamp(1.5rem, 2.4vw, 2rem); margin: 2.2rem 0 0.9rem; }
  .post-body :global(h3) { font-size: clamp(1.25rem, 1.9vw, 1.55rem); margin: 1.8rem 0 0.75rem; }
  .post-body :global(p) { margin: 0 0 1.15rem; }
  .post-body :global(ul), .post-body :global(ol) { margin: 0 0 1.15rem 1.4rem; display: grid; gap: 0.5rem; }
  .post-body :global(a) { color: var(--burgundy, #641f24); text-decoration: underline; }
  .post-body :global(blockquote) {
    margin: 1.6rem 0; padding: 0.6rem 0 0.6rem 1.4rem;
    border-left: 3px solid var(--burgundy, #641f24);
    font-style: italic; color: var(--burgundy-dark, #4a0f15);
  }
  .post-author-card {
    display: flex; gap: 1.2rem; align-items: flex-start;
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding: clamp(1.5rem, 3vw, 2.25rem);
    background: rgba(255, 250, 242, 0.7);
    border: 1px solid rgba(168, 148, 131, 0.32);
    border-radius: 22px;
  }
  .post-author-photo { width: 84px; height: 84px; border-radius: 50%; overflow: hidden; flex: 0 0 auto; border: 1px solid rgba(181, 138, 68, 0.4); }
  .post-author-card h2 { font-size: clamp(1.25rem, 1.9vw, 1.5rem); margin: 0.2rem 0 0.3rem; }
  .post-author-card h2 a { color: var(--burgundy-dark, #4a0f15); text-decoration: none; }
  .post-author-role { font-size: 0.92rem; color: rgba(81, 70, 63, 0.85); margin: 0 0 0.6rem; }
  .post-author-link { display: inline-block; margin-top: 0.6rem; font-weight: 700; color: var(--burgundy, #641f24); text-decoration: none; }
  @media (max-width: 560px) {
    .post-author-card { flex-direction: column; }
  }
</style>
